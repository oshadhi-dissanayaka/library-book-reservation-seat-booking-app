# EXPO_PUBLIC_API_URL: Backend API Base URL for Library Staff Module
# Port 5001 is used because on Windows, port 5000 is occupied by Windows HTTPAPI (PID 4) returning 403 Forbidden.
# When running on Expo Go on a physical phone, replace "localhost" with your laptop's local Wi-Fi IP address (run `ipconfig` to find IPv4 address):
# Example: EXPO_PUBLIC_API_URL=http://192.168.8.100:5001/api/staff
EXPO_PUBLIC_API_URL=http://localhost:5001/api/staff
