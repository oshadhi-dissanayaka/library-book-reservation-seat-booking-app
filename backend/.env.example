# Copy to backend/.env and fill in real values. Never commit backend/.env.

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/libconnect

# API port (optional - defaults to 5000)
PORT=5000

# JWT signing secret (required for /api/auth and staff/management login).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# Optional demo credentials used only by scripts/seedAuth.js for the
# pre-created privileged accounts (hashed before storage, never stored plain):
# LIBRARY_STAFF_DEMO_PASSWORD=Mihan123
# MANAGEMENT_DEMO_PASSWORD=Oshadi123

# Optional: audit-log fallback staff id when a caller omits staffId
# STAFF_USERNAME=LIB001
